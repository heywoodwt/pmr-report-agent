# Copy to backend.hcl (ignored by git). Create this storage account once, outside this
# configuration, and grant yourself Storage Blob Data Contributor on it.
resource_group_name  = "rg-tfstate"
storage_account_name = "sttfstate<unique>"
container_name       = "tfstate"
key                  = "pmr.tfstate"
use_azuread_auth     = true
